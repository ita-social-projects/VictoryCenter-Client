{
  "//": "=== LINUX / macOS Configuration ===",
  "//": "For Linux and macOS, use direct npx command:",
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "github-mcp", "stdio"],
      "env": {
        "GITHUB_ACCESS_TOKEN": "ghp_YOUR_GITHUB_TOKEN_HERE"
      }
    }
  },

  "//": "=== WINDOWS Configuration (Option 1: cmd wrapper) ===",
  "//": "For Windows, use cmd /c wrapper:",
  "mcpServers_WINDOWS_OPTION_1": {
    "github": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "github-mcp", "stdio"],
      "env": {
        "GITHUB_ACCESS_TOKEN": "ghp_YOUR_GITHUB_TOKEN_HERE"
      }
    }
  },

  "//": "=== WINDOWS Configuration (Option 2: full path - RECOMMENDED) ===",
  "//": "For Windows, use full path to npx.cmd (more reliable):",
  "mcpServers_WINDOWS_OPTION_2": {
    "github": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "github-mcp", "stdio"],
      "env": {
        "GITHUB_ACCESS_TOKEN": "ghp_YOUR_GITHUB_TOKEN_HERE"
      }
    }
  }
}
